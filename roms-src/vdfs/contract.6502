\ SPDX-License-Identifier: CC0-1.0
\ The ports and codes the VDFS ROM shares with the host (docs/vdfs.md, which says what each port does). The host's copy is in
\ src/vdfs-protocol.js, and tests/unit/test-vdfs-protocol.js fails if the two differ.

PortBase    = &FC60
PortGo      = PortBase + 0
PortA       = PortBase + 1
PortX       = PortBase + 2
PortY       = PortBase + 3
HostId      = &16
IdMask      = &3F
CarryBit    = &40

CallService = 0
CallFile    = 1
CallArgs    = 2
CallBget    = 3
CallBput    = 4
CallGbpb    = 5
CallFind    = 6
CallFsc     = 7

OpDone      = 0
OpPrint     = 1
OpError     = 2
OpExec      = 3
OpClaim     = 4
