\ The ports and codes the VDFS ROM shares with the host (docs/vdfs.md). The host's copy is in
\ src/vdfs-protocol.js, and tests/unit/test-vdfs-protocol.js fails if the two differ.

PortBase    = &FC60
\ Written with a call's number to start it. Read for the status: bit 7 busy, bit 6 the carry out, bits 0 to 5 HostId.
PortGo      = PortBase + 0
\ Written with the caller's register; read for the response, a byte at a time: its ops, OpDone, then the A it returns.
PortA       = PortBase + 1
\ Written with the caller's register; read for the X the call returns.
PortX       = PortBase + 2
\ Written with the caller's register; read for the Y the call returns.
PortY       = PortBase + 3
HostId      = &16
IdMask      = &3F
CarryBit    = &40

CallService = 0
CallFile    = 1
CallArgs    = 2
CallBget    = 3
CallBput    = 4
CallGbpb    = 5
CallFind    = 6
CallFsc     = 7

OpDone      = 0
OpPrint     = 1
OpError     = 2
OpExec      = 3
OpClaim     = 4
